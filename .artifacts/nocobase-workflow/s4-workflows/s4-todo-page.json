    "item": {
      "title": "审批待办",
      "icon": "AuditOutlined"
    }
  },
  "page": {
    "title": "审批待办"
  },
  "tabs": [
    {
      "key": "leave",
      "title": "请假待审",
      "blocks": [
        {
          "key": "leaveTodoTable",
          "type": "table",
          "collection": "nb_dx_leave",
          "fields": [
            "student_name",
            "klass.name",
            "type",
            "start_time",
            "end_time",
            "duration_days",
            "over_ratio"
          ],
          "recordActions": [
            "view"
          ],
          "settings": {
            "dataScope": {
              "filter": {
                "logic": "$and",
                "items": [
                  {
                    "path": "status",
                    "operator": "$eq",
                    "value": "pending"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "key": "dropout",
      "title": "退学待审",
      "blocks": [
        {
          "key": "dropoutTodoTable",
          "type": "table",
          "collection": "nb_dx_dropout",
          "fields": [
            "student_name",
            "klass.name",
            "reason",
            "status"
          ],
          "recordActions": [
            "view"
          ],
          "settings": {
            "dataScope": {
              "filter": {
                "logic": "$and",
                "items": [
                  {
                    "path": "status",
                    "operator": "$eq",
                    "value": "pending"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "key": "registration",
      "title": "报名待审",
      "blocks": [
        {
          "key": "regTodoTable",
          "type": "table",
          "collection": "nb_dx_registration",
          "fields": [
            "name",
            "klass.name",
            "phone",
            "gender",
            "work_unit",
            "status"
          ],
          "recordActions": [
            "view"
          ],
          "settings": {
            "dataScope": {
              "filter": {
                "logic": "$and",
                "items": [
                  {
                    "path": "status",
                    "operator": "$eq",
                    "value": "pending"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "key": "payment",
      "title": "缴费待审",
      "blocks": [
        {
          "key": "payTodoTable",
          "type": "table",
          "collection": "nb_dx_payment",
          "fields": [
            "payer_name",
            "klass.name",
            "amount",
            "method",
            "channel",
            "status"
          ],
          "recordActions": [
            "view"
          ],
          "settings": {
            "dataScope": {
              "filter": {
                "logic": "$and",
                "items": [
                  {
                    "path": "status",
                    "operator": "$eq",
                    "value": "pending"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "defaults": {
    "collections": {
      "nb_dx_registration": {
        "formBehaviorDescriptionReview": {
          "fields": {
            "form_data": {
              "decision": "unsupported",
              "reasonCode": "ambiguous-description"
            }
          }
        }
      },
      "nb_dx_payment": {
        "popups": {
          "view": {
            "name": "查看缴费凭证",
