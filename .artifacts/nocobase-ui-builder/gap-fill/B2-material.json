{
 "version": "1",
 "mode": "create",
 "assets": {
  "charts": {
   "matByKind": {
    "query": {
     "mode": "builder",
     "resource": {
      "dataSourceKey": "main",
      "collectionName": "nb_dx_material"
     },
     "measures": [
      {
       "field": "id",
       "aggregation": "count",
       "alias": "matCount"
      }
     ],
     "dimensions": [
      {
       "field": "kind"
      }
     ]
    },
    "visual": {
     "mode": "basic",
     "type": "pie",
     "mappings": {
      "category": "kind",
      "value": "matCount"
     }
    }
   }
  }
 },
 "defaults": {
  "collections": {
   "nb_dx_material": {
    "popups": {
     "view": {
      "name": "查看材料",
