       "student_no",
       "gender",
       "birth_date",
       "political_status",
       "phone",
       "photo"
      ]
     },
     {
      "key": "studentWork",
      "title": "单位与班级",
      "fields": [
       "work_unit",
       "duty",
       "group_no",
       "klass",
       "user"
