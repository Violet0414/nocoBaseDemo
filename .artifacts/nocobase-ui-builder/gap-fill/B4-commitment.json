      "name": "查看学员",
      "description": "查看一条学员详情"
     }
    },
    "fieldGroups": [
     {
      "key": "studentBasic",
      "title": "基本信息",
      "fields": [
       "name",
       "student_no",
       "gender",
       "birth_date",
       "political_status",
       "phone",
       "photo"
      ]
     },
     {
      "key": "studentWork",
      "title": "单位与班级",
      "fields": [
       "work_unit",
       "duty",
       "group_no",
       "klass",
       "user"
      ]
     },
     {
      "key": "studentStatus",
      "title": "学籍状态",
      "fields": [
       "status",
       "enroll_status",
       "excellent",
       "remark"
      ]
     }
    ]
   }
  }
 },
