{
 "version": "1",
 "mode": "create",
 "assets": {
  "charts": {
   "signByStatus": {
    "query": {
     "mode": "builder",
     "resource": {
      "dataSourceKey": "main",
      "collectionName": "nb_dx_commitment"
     },
     "measures": [
      {
       "field": "id",
       "aggregation": "count",
       "alias": "signCount"
      }
     ],
     "dimensions": [
      {
       "field": "signed"
      }
     ]
    },
    "visual": {
     "mode": "basic",
     "type": "pie",
     "mappings": {
      "category": "signed",
      "value": "signCount"
     }
    }
   }
  }
 },
 "defaults": {
  "collections": {
   "nb_dx_commitment": {
    "popups": {
     "view": {
      "name": "纪律承诺",
      "description": "查看一条纪律承诺详情"
     }
    }
   },
   "nb_dx_class": {
    "popups": {
     "view": {
      "name": "查看班次",
      "description": "查看一条班次记录详情"
     }
    },
    "fieldGroups": [
     {
      "key": "classBasic",
      "title": "基本信息",
      "fields": [
       "name",
       "code",
       "category",
       "train_type",
       "status",
       "organizer"
      ]
     },
     {
      "key": "classPeriod",
