       "alias": "subCount"
      }
     ],
     "dimensions": [
      {
       "field": "status"
      }
     ]
    },
    "visual": {
     "mode": "basic",
     "type": "pie",
     "mappings": {
      "category": "status",
      "value": "subCount"
     }
    }
   }
  }
 },
