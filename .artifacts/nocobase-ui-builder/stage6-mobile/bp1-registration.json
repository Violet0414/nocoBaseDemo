            "fields": [
              "name",
              "code",
              "category",
              "train_type",
              "status",
              "organizer"
            ]
          },
          {
            "key": "classPeriod",
            "title": "报名与学习周期",
            "fields": [
              "enroll_start",
              "enroll_end",
              "start_date",
              "end_date",
              "total_days",
              "total_hours"
            ]
