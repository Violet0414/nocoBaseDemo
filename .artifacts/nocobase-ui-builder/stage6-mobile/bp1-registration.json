              "addNew": {
                "name": "新增审核人",
                "description": "新增审核人。"
              },
              "edit": {
                "name": "编辑审核人",
                "description": "编辑审核人。"
              }
            }
          }
        },
        "formBehaviorDescriptionReview": {
          "fields": {
            "form_data": {
              "decision": "noUiBehavior",
              "reasonCode": "ambiguous-description"
            }
          }
