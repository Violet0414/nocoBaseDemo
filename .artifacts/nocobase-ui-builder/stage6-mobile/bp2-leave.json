{
  "version": "1",
  "mode": "create",
  "navigation": {
    "portalUid": "__default_mobile__",
    "item": {
      "title": "请假申请",
      "icon": "FileDoneOutlined"
    }
  },
  "page": {
    "title": "请假申请"
  },
  "tabs": [
    {
      "key": "main",
      "title": "请假申请",
      "layout": {
        "rows": [
          [
            {
              "key": "leaveForm",
              "span": 12
            },
            {
              "key": "myLeaves",
              "span": 12
            }
          ]
        ]
      },
      "blocks": [
        {
          "key": "leaveForm",
          "type": "createForm",
          "collection": "nb_dx_leave",
          "title": "提交请假申请",
          "fields": [
            {
              "field": "student",
              "titleField": "name"
            },
            {
              "field": "klass",
              "titleField": "name"
            },
            "type",
            "reason",
            "start_time",
            "end_time",
            "duration_days"
          ]
        },
        {
          "key": "myLeaves",
          "type": "table",
          "collection": "nb_dx_leave",
          "title": "我的请假记录",
          "fields": [
            "type",
            "start_time",
            "end_time",
            "duration_days",
            "status"
          ],
          "recordActions": [
            "view"
          ]
        }
      ]
    }
  ],
  "defaults": {
    "collections": {
      "nb_dx_leave": {
        "popups": {
          "view": {
            "name": "请假详情",
            "description": "查看一条请假记录。"
          },
          "addNew": {
            "name": "新增请假",
            "description": "新增一条请假记录。"
          },
          "edit": {
            "name": "编辑请假",
            "description": "编辑一条请假记录。"
          },
          "associations": {
            "student": {
              "view": {
                "name": "学员详情",
                "description": "查看关联学员。"
              },
              "addNew": {
                "name": "新增学员",
                "description": "新增关联学员。"
              },
              "edit": {
                "name": "编辑学员",
                "description": "编辑关联学员。"
              }
            },
            "klass": {
              "view": {
                "name": "班次详情",
                "description": "查看关联班次。"
              },
              "addNew": {
                "name": "新增班次",
                "description": "新增关联班次。"
              },
              "edit": {
                "name": "编辑班次",
                "description": "编辑关联班次。"
              }
            }
          }
        },
        "formBehaviorDescriptionReview": {
          "fields": {
            "duration_days": {
              "decision": "noUiBehavior",
              "reasonCode": "ambiguous-description"
            }
          }
        }
      },
      "nb_dx_class": {
        "popups": {
          "view": {
            "name": "班次详情",
            "description": "查看一条班次记录。"
          },
          "addNew": {
            "name": "新增班次",
            "description": "新增一条班次记录。"
          },
          "edit": {
            "name": "编辑班次",
            "description": "编辑一条班次记录。"
          }
        },
        "fieldGroups": [
          {
            "key": "classBasic",
            "title": "基本信息",
            "fields": [
              "name",
              "code",
              "category",
              "train_type",
              "status",
              "organizer"
            ]
          },
          {
            "key": "classPeriod",
            "title": "报名与学习周期",
            "fields": [
              "enroll_start",
              "enroll_end",
              "start_date",
              "end_date",
              "total_days",
              "total_hours"
            ]
          },
          {
            "key": "classOther",
            "title": "教室与其他",
            "fields": [
              "default_room",
              "room_locked",
              "qr_token",
              "description"
            ]
          }
        ]
      },
      "nb_dx_student": {
        "popups": {
          "view": {
            "name": "学员详情",
            "description": "查看一条学员记录。"
          },
          "addNew": {
            "name": "新增学员",
            "description": "新增一条学员记录。"
          },
          "edit": {
            "name": "编辑学员",
            "description": "编辑一条学员记录。"
          }
        },
        "fieldGroups": [
          {
            "key": "stuBasic",
            "title": "基本信息",
            "fields": [
              "name",
              "student_no",
              "gender",
              "birth_date",
              "political_status",
              "phone",
              "photo"
            ]
          },
          {
            "key": "stuUnit",
            "title": "单位与班次",
            "fields": [
              "work_unit",
              "duty",
              "group_no",
              "klass",
              "user"
            ]
          },
          {
            "key": "stuStatus",
            "title": "学籍状态",
            "fields": [
              "status",
              "enroll_status",
              "excellent",
              "remark"
            ]
          }
        ]
      }
    }
  }
}