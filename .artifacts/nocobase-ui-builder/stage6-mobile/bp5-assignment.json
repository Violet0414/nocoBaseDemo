{
  "version": "1",
  "mode": "create",
  "navigation": {
    "portalUid": "__default_mobile__",
    "item": {
      "title": "我的作业",
      "icon": "BookOutlined"
    }
  },
  "page": {
    "title": "我的作业"
  },
  "tabs": [
    {
      "key": "main",
      "title": "我的作业",
      "layout": {
        "rows": [
          [
            {
              "key": "assignmentTable",
              "span": 12
            },
            {
              "key": "submitForm",
              "span": 12
            }
          ]
        ]
      },
      "blocks": [
        {
          "key": "assignmentTable",
          "type": "table",
          "collection": "nb_dx_assignment",
          "title": "作业列表",
          "fields": [
            "name",
            {
              "field": "klass",
              "titleField": "name"
            },
            {
              "field": "topic",
              "titleField": "name"
            },
            {
              "field": "teacher",
              "titleField": "nickname"
            },
            "due_date",
            "status"
          ],
          "recordActions": [
            "view"
          ]
        },
        {
          "key": "submitForm",
          "type": "createForm",
          "collection": "nb_dx_submission",
          "title": "提交作业",
          "fields": [
            {
              "field": "assignment",
              "titleField": "name"
            },
            {
              "field": "student",
              "titleField": "name"
            },
            "content",
            "attachment",
            "submitted_at"
          ]
        }
      ]
    }
  ],
